<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DataBalance.ViewModels"
    xmlns:views="clr-namespace:DataBalance.Views.States;assembly=DataBalance"
    x:Class="DataBalance.Views.DataBalanceView"
    x:DataType="vm:DataBalanceViewModel"
    mc:Ignorable="d"
    d:DesignWidth="300"
    d:DesignHeight="330"
>
    <UserControl.Styles>
        <Style Selector="Button.compact">
            <Setter
                Property="Height"
                Value="34"
            />
            <Setter
                Property="Padding"
                Value="14,0"
            />
            <Setter
                Property="CornerRadius"
                Value="6"
            />
            <Setter
                Property="FontSize"
                Value="10"
            />
            <Setter
                Property="FontWeight"
                Value="SemiBold"
            />
            <Setter
                Property="Background"
                Value="#18FFFFFF"
            />
            <Setter
                Property="Foreground"
                Value="#DFFFFFFF"
            />
        </Style>
        <Style Selector="Button.primary">
            <Setter
                Property="Height"
                Value="32"
            />
            <Setter
                Property="Padding"
                Value="14,0"
            />
            <Setter
                Property="CornerRadius"
                Value="5"
            />
            <Setter
                Property="FontSize"
                Value="10"
            />
            <Setter
                Property="FontWeight"
                Value="Bold"
            />
            <Setter
                Property="Background"
                Value="#60CDFF"
            />
            <Setter
                Property="Foreground"
                Value="#10232B"
            />
        </Style>
        <Style Selector="Button.icon">
            <Setter
                Property="Width"
                Value="28"
            />
            <Setter
                Property="Height"
                Value="28"
            />
            <Setter
                Property="Padding"
                Value="0"
            />
            <Setter
                Property="CornerRadius"
                Value="14"
            />
            <Setter
                Property="MinWidth"
                Value="28"
            />
            <Setter
                Property="MinHeight"
                Value="28"
            />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Center"
            />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center"
            />
            <Setter
                Property="Background"
                Value="#16FFFFFF"
            />
            <Setter
                Property="Foreground"
                Value="#DFFFFFFF"
            />
        </Style>
        <Style Selector="Button.connection">
            <Setter
                Property="MinHeight"
                Value="48"
            />
            <Setter
                Property="Padding"
                Value="10,8"
            />
            <Setter
                Property="CornerRadius"
                Value="5"
            />
            <Setter
                Property="HorizontalAlignment"
                Value="Stretch"
            />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch"
            />
            <Setter
                Property="Background"
                Value="#0DFFFFFF"
            />
            <Setter
                Property="BorderBrush"
                Value="#18FFFFFF"
            />
            <Setter
                Property="BorderThickness"
                Value="1"
            />
        </Style>
        <Style Selector="ProgressBar.usage">
            <Setter
                Property="Height"
                Value="3"
            />
            <Setter
                Property="Foreground"
                Value="#60CDFF"
            />
            <Setter
                Property="Background"
                Value="#25FFFFFF"
            />
        </Style>
    </UserControl.Styles>

    <!-- Each application state is implemented in its own view. -->
    <Border
        MinWidth="276"
        MinHeight="330"
        Padding="16"
        Background="Transparent"
    >
        <Grid>
            <views:DependencySetupView />
            <views:AccountEntryView />
            <views:OtpVerificationView />
            <views:ConnectionPickerView />
            <views:ConnectionErrorView />
            <views:BalanceDashboardView />
        </Grid>
    </Border>
</UserControl>
