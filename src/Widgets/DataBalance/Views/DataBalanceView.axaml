<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DataBalance.ViewModels"
    xmlns:models="using:DataBalance.Models"
    x:Class="DataBalance.Views.DataBalanceView"
    x:DataType="vm:DataBalanceViewModel"
    mc:Ignorable="d"
    d:DesignWidth="300"
    d:DesignHeight="330">

    <Border Width="300" MinHeight="330" Padding="12" Background="Transparent">
        <Grid>
            <!-- First-use account entry -->
            <StackPanel IsVisible="{Binding IsAccountEntryVisible}"
                        VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Connect MyDialog" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Enter the email address or Dialog mobile number linked to your account."
                           FontSize="11" Foreground="#A0FFFFFF" TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBox x:Name="AccountInput" Text="{Binding AccountIdentifier}"
                         Watermark="Email or mobile number" FontSize="12"
                         KeyDown="AccountInput_KeyDown" />
                <Button Content="CONTINUE" HorizontalAlignment="Stretch"
                        Click="ContinueButton_Click" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                           Foreground="#80FFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <!-- Manual OTP entry -->
            <StackPanel IsVisible="{Binding IsOtpVisible}"
                        VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Verification code" FontSize="19" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="#A0FFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
                <StackPanel x:Name="OtpBoxesPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="5" />
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Margin="0,0,4,0" Content="BACK" Click="CancelOtpButton_Click" />
                    <Button Grid.Column="1" Margin="4,0,0,0" Content="RESEND" IsEnabled="{Binding CanResendOtp}"
                            Click="ResendOtpButton_Click" />
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshing}" Height="3" />
            </StackPanel>

            <!-- Linked connection chooser -->
            <Grid IsVisible="{Binding IsConnectionPickerVisible}" RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Choose connection" FontSize="18"
                           FontWeight="SemiBold" Foreground="White" />
                <TextBlock Grid.Row="1" Margin="0,5,0,8" Text="{Binding StatusMessage}"
                           FontSize="10" Foreground="#90FFFFFF" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DialogConnection">
                                <Button Margin="0,0,0,6" Padding="10" HorizontalContentAlignment="Stretch"
                                        Click="ConnectionButton_Click">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding PackageName}" Foreground="#80FFFFFF"
                                                       FontSize="9" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FriendlyType}"
                                                   Foreground="#60CDFF" FontSize="9"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="3" Margin="0,6,0,0" Content="SIGN OUT AND REMOVE ACCOUNT"
                        Click="SignOutButton_Click" />
            </Grid>

            <!-- Recoverable network or service error -->
            <StackPanel IsVisible="{Binding IsErrorVisible}"
                        VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Unable to load balance" FontSize="18" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#A0FFFFFF"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="TRY AGAIN" Click="RefreshButton_Click" />
                <Button Content="SIGN OUT AND REMOVE ACCOUNT" Click="SignOutButton_Click" />
            </StackPanel>

            <!-- Authenticated balance -->
            <Grid IsVisible="{Binding IsBalanceVisible}" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <Border Grid.Row="0" Padding="2,2,2,10" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding ConnectionName}" FontSize="14" FontWeight="Bold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ConnectionKind}" FontSize="9" Foreground="#60CDFF" />
                            <TextBlock Text="{Binding PhoneNumber}" FontSize="9" Foreground="#78FFFFFF" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="28" Height="28" Margin="4,0" Padding="0"
                                Content="⇄" ToolTip.Tip="Change connection"
                                Click="ChooseConnectionButton_Click" />
                        <Button Grid.Column="2" Width="28" Height="28" Padding="0"
                                Content="⎋" ToolTip.Tip="Sign out and remove account"
                                Click="SignOutButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="2,10" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="PREPAID BALANCE" FontSize="9" Foreground="#78FFFFFF" />
                            <TextBlock Text="{Binding Balance}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Validity}" FontSize="9"
                                   Foreground="#A0FFFFFF" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="2,9" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding PackageOneType}" FontSize="9" Foreground="#78FFFFFF" />
                            <TextBlock Grid.Column="1" Text="{Binding PackageOneRemaining}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#60CDFF" />
                        </Grid>
                        <ProgressBar Height="4" Maximum="100" Value="{Binding PackageOnePercentage}"
                                     Foreground="#60CDFF" Background="#28FFFFFF" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding PackageOneName}" FontSize="9" Foreground="#75FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding PackageOneExpiry}" FontSize="9"
                                       Foreground="#60CDFF" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Padding="2,9" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding PackageTwoType}" FontSize="9" Foreground="#78FFFFFF" />
                            <TextBlock Grid.Column="1" Text="{Binding PackageTwoRemaining}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#60CDFF" />
                        </Grid>
                        <ProgressBar Height="4" Maximum="100" Value="{Binding PackageTwoPercentage}"
                                     Foreground="#60CDFF" Background="#28FFFFFF" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding PackageTwoName}" FontSize="9" Foreground="#75FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding PackageTwoExpiry}" FontSize="9"
                                       Foreground="#60CDFF" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4" Margin="2,8,2,0" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="9" Foreground="#54D98C" />
                        <TextBlock Text="{Binding UpdatedText}" FontSize="9" Foreground="#65FFFFFF" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" Content="↻"
                            ToolTip.Tip="Refresh now" Click="RefreshButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
